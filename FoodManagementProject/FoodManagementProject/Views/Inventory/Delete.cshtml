@model FoodManagementProject.Models.InventoryBatch

@{
    ViewData["Title"] = "Delete inventory batch";
}

<div class="ingredient-add-page">
    <h1 class="ingredient-page-title">Delete inventory batch</h1>

    <p class="ingredient-page-description">Are you sure you want to delete this batch?</p>

        <!--displaying the batch so the user can see what they are deleting-->
        <dl class="inventory-delete-details">
            <dt>Ingredient</dt>
            <dd>@Model.Ingredient.IngredientName</dd>

            <dt>Quantity</dt>
            <dd>@(Model.Quantity.HasValue ? Model.Quantity.Value.ToString("0.##") : "Not specified")</dd>

            <dt>Expiration date</dt>
            <dd>@(Model.ExpirationDate.HasValue ? Model.ExpirationDate.Value.ToString("dd/MM/yyyy") : "Not specified")</dd>
        </dl>
        
        <!--submitting the batch id to the POST delete action in the inventory controller-->
        <form asp-controller="Inventory" asp-action="Delete" asp-route-ingredientbatchid="@Model.IngredientBatchId" method="post">
            <button type="submit" class="inventory-delete-button">Delete batch</button>
        </form>
        
        <a asp-controller="Inventory" asp-action="Index" class="ingredient-back-link">Cancel</a>
</div>