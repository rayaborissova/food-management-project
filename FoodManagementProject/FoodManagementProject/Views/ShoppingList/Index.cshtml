@model IEnumerable<FoodManagementProject.Models.ShoppingListItem>

@{
    ViewData["Title"] = "Shopping list";
}

<div class="page">
    <h1 class="page__title">Shopping List</h1>
    <p class="page__lead">Check off ingredients as you shop</p>

    <a asp-controller="ShoppingList" asp-action="Add" class="btn btn--primary">Add ingredients</a>

    @if (TempData["ShoppingListSuccess"] is string successMessage)
    {
        <p role="status" class="notice">@successMessage</p>

        <script>
            sessionStorage.removeItem("shoppingListSelectedIngredientIds");
        </script>
    }

    @if (TempData["ShoppingListEditSuccess"] is string editMessage)
    {
        <p role="status" class="notice">@editMessage</p>
    }

    @if (TempData["ShoppingListDeleteSuccess"] is string deleteMessage)
    {
        <p role="status" class="notice">@deleteMessage</p>
    }

    @if (!Model.Any())
    {
        <p class="empty-state">Your shopping list is empty</p>
    }
    else
    {
        @foreach (var categoryGroup in Model.GroupBy(item => item.Ingredient.Category.CategoryName).OrderBy(group => group.Key))
        {
            <section class="category-group">
                <h2 class="category-group__title">@categoryGroup.Key</h2>
                <ul class="shop-list">
                    @foreach (var item in categoryGroup)
                    {
                        <li class="shop-item">
                            <input type="checkbox" id="shopping-item-@item.ShoppingListItemId" name="purchasedItemIds" value="@item.ShoppingListItemId" class="checkbox" />
                            <label for="shopping-item-@item.ShoppingListItemId" class="shop-item__label">
                                <span class="shop-item__name">@item.Ingredient.IngredientName</span>
                                <span class="shop-item__amount">
                                    @if (item.Quantity.HasValue)
                                    {
                                        @item.Quantity.Value.ToString("0.##")
                                    }
                                    @if (item.Unit != null)
                                    {
                                        <text> @item.Unit.UnitName</text>
                                    }
                                </span>
                            </label>

                            <div class="shop-item__actions">
                                <a asp-controller="ShoppingList" asp-action="Edit" asp-route-id="@item.ShoppingListItemId" class="icon-btn icon-btn--soft" aria-label="Edit"><i class="ti ti-pencil" aria-hidden="true"></i>Edit</a>
                                <a asp-controller="ShoppingList" asp-action="Delete" asp-route-id="@item.ShoppingListItemId" class="icon-btn icon-btn--danger" aria-label="Remove"><i class="ti ti-trash" aria-hidden="true"></i>Remove</a>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

    }

    @if (Model.Any())
    {
        <form asp-controller="ShoppingList" asp-action="AddAsListed" method="post" id="confirm-purchase-form">
            <div id="checked-purchase-inputs"></div>

            <div class="toolbar">
                <button type="submit" class="btn btn--sage">Add to inventory as listed</button>
                <button type="submit" asp-controller="ShoppingList" asp-action="EditPurchase" class="btn btn--outline">Add to inventory (edit details)</button>
            </div>

            <p class="page__lead">"As listed" uses the quantities from your list. "Edit details" lets you change quantities and units and add expiration dates first.</p>
        </form>
    }
    <a asp-controller="Inventory" asp-action="Index" class="back-link">
        Back to Inventory
    </a>

</div>

@section Scripts {
    <script src="~/js/shopping-list-index.js" asp-append-version="true"></script>
}