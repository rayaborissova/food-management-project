@model IEnumerable<FoodManagementProject.Models.ShoppingListItem>

@{
    ViewData["Title"] = "Shopping list";
}

<div class="ingredient-add-page">
    <h1 class="ingredient-page-title">Shopping List</h1>
    <p class="ingredient-page-description">Check off ingredients as you shop</p>

    @if (TempData["ShoppingListSuccess"] is string successMessage)
    {
        <p role="status">@successMessage</p>

        <script>
            sessionStorage.removeItem("shoppingListSelectedIngredientIds");
        </script>
    }

    @if (TempData["ShoppingListEditSuccess"] is string editMessage)
    {
        <p role="status">@editMessage</p>
    }


    @if (!Model.Any())
    {
        <p class="ingredient-empty-message">Your shopping list is empty</p>
    } else
    {
        @foreach (var categoryGroup in Model.GroupBy(item => item.Ingredient.Category.CategoryName).OrderBy(group => group.Key))
            {
                <section class="shopping-category">
                    <h2 class="shopping-category-title">@categoryGroup.Key</h2>
                    <ul class="shopping-items">
                    @foreach (var item in categoryGroup)
                    {
                            <li class="shopping-item">
                                <input type="checkbox" id="shopping-item-@item.ShoppingListItemId" name="purchasedItemIds" value="@item.ShoppingListItemId" class="shopping-item-checkbox" />
                                <label for="shopping-item-@item.ShoppingListItemId" class="shopping-item-label">
                                    <span class="shopping-item-name">@item.Ingredient.IngredientName</span>
                                    <span class="shopping-item-amount">
                                    @if(item.Quantity.HasValue) 
                                    {
                                        @item.Quantity.Value.ToString("0.##")
                                    }
                                    @if(item.Unit != null)
                                    {
                                        <text> @item.Unit.UnitName</text>
                                    }
                                </span>
                                </label>
                                <a asp-controller="ShoppingList" asp-action="Edit" asp-route-id="@item.ShoppingListItemId" class="shopping-edit-link">Edit</a>
                            </li>
                    }
                    </ul>
                </section>
            }

    }

    <form asp-controller="ShoppingList" asp-action="ConfirmPurchase" method="post" id="confirm-purchase-form">
        <div id="checked-purchase-inputs"></div>
        <button type="submit" class="ingredient-search-button">Add to inventory</button>

    </form>

    <a asp-controller="Inventory" asp-action="Index" class="ingredient-back-link">
        Back to Inventory
    </a>

</div>


<script>
    const purchaseStorageKey = "shoppingListCheckedItemIds";

    let checkedItemIds = JSON.parse(sessionStorage.getItem(purchaseStorageKey) || "[]");

    const purchaseCheckboxes = document.querySelectorAll('input[name="purchasedItemIds"]');

    //keeping only the IDs that still appear as active
    const activeItemIds = Array.from(purchaseCheckboxes, checkbox => checkbox.value);

    checkedItemIds = checkedItemIds.filter(id => activeItemIds.includes(id));

    function savePurchaseChecks() {
        sessionStorage.setItem(purchaseStorageKey, JSON.stringify(checkedItemIds));
    }

    for (const checkbox of purchaseCheckboxes) {
        //restoring the checkmark
        checkbox.checked = checkedItemIds.includes(checkbox.value);

        checkbox.addEventListener("change", function() {
            if(checkbox.checked) {
                if(!checkedItemIds.includes(checkbox.value)) {
                    checkedItemIds.push(checkbox.value);
                } 
            } else {
                checkedItemIds = checkedItemIds.filter(id => id !== checkbox.value);
            }

            savePurchaseChecks();
        });
    }
    // removing the outdated IDs
    savePurchaseChecks();

    const purchaseForm =document.getElementById("confirm-purchase-form");
    const purchaseInputs = document.getElementById("checked-purchase-inputs");

    purchaseForm.addEventListener("submit", function (event) {
        if (checkedItemIds.length === 0) {
            event.preventDefault();
            alert("Check at least one purchased item");
            return;
        }

        purchaseInputs.replaceChildren();

        for(const id of checkedItemIds) {
            const input = document.createElement("input");

            input.type= "hidden";
            input.name = "purchasedItemIds";
            input.value = id;

            purchaseInputs.appendChild(input);
        }
    });

</script>