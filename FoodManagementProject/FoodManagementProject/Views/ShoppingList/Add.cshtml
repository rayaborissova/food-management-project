@model IEnumerable<FoodManagementProject.Models.Ingredient>

@{
    ViewData["Title"] = "Add to shopping list";
}

<div class="page page--picker" data-storage-key="shoppingListSelectedIngredientIds">

    <h1 class="page__title">Add to shopping list </h1>
    <p class="page__lead">Search for what you need to buy</p>

    <form asp-controller="ShoppingList" asp-action="Add" method="get" class="search">
        <label for="ingredient-search" class="field__label">Search ingredients</label>

        <div class="search__controls">
            <input id="ingredient-search" type="search" name="search" value="@ViewData["Search"]" placeholder="Search ingredients" class="input" />
            <button type="submit" class="btn btn--primary search__btn" aria-label="Search"><i class="ti ti-search" aria-hidden="true"></i><span class="search__btn-text">Search</span></button>
        </div>
    </form>
    
    <p class="request-link">Can't find it? <a asp-controller="IngredientRequests" asp-action="Index" asp-route-name="@ViewData["Search"]">Suggest a new ingredient</a></p>

    <div class="selection-bar">
        <!--removed class toolbar-->
        <p id="selection-count" role="status">0 ingredients selected</p> <!--removed class selection-count-->
        <button type="button" id="clear-selection" class="btn btn--outline btn--sm" hidden>Clear selection</button>
        <button type="button" id="undo-selection" class="btn btn--outline btn--sm" hidden>Undo clear</button>
    </div>
        
    @if (!Model.Any())
    {
        <p class="empty-state">No matching ingredients found. Try another search</p>
    }
    else
    { //from add to inventroy page
        <div class="table-wrap" tabindex="0" role="region" aria-label="Ingredient results">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Select</th>
                        <th scope="col">Ingredient</th>
                        <th scope="col"><span class="visually-hidden">Report</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ingredient in Model) /*creates one table row for each ingredient*/
                    {
                        <tr>
                            <td class="pick-cell--shrink">
                                <input type="checkbox" id="ingredient-@ingredient.IngredientId" name="selectedIngredientIds"
                                       value="@ingredient.IngredientId" class="checkbox" />
                            </td> <!-- stores id of the ingredient as the value of the checkbox-->
                            <td>
                                <label for="ingredient-@ingredient.IngredientId" class="pick-row__name">
                                    @ingredient.IngredientName
                                </label> <!-- name is connected to the checkbox as well so clicking on name ticks it-->
                                <span class="pick-cat">@ingredient.Category?.CategoryName</span>
                            </td>
                            <td class="pick-cell--shrink">
                                <a asp-controller="IngredientReports" asp-action="Create" asp-route-ingredientId="@ingredient.IngredientId" class="icon-btn icon-btn--plain" title="Report a problem"><i class="ti ti-flag" aria-hidden="true"></i><span class="visually-hidden">Report a problem with @ingredient.IngredientName</span></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="picker-footer">
        <!--removed class action-bar -->
        <a asp-controller="ShoppingList" asp-action="Index" class="back-link">Back to shopping list</a>

        <form asp-controller="ShoppingList" asp-action="Review" method="post" id="review-selected-form">
            <div id="selected-ingredient-inputs"></div>
            <button type="submit" id="review-selected" class="btn btn--primary" disabled>Review selected</button>
        </form>
    </div>

</div>

@section Scripts {
    <script src="~/js/ingredient-picker.js" asp-append-version="true"></script>
}
