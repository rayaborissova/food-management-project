@model FoodManagementProject.Models.ShoppingListItem

@{
    ViewData["Title"] = "Remove shopping list item";
}

<div class="page">

    <h1 class="page__title">Remove item</h1>
   
    <p class="page__lead">Remove this item from your shopping list? Your inventory would not be changed</p>
    <dl class="details-list">
        <dt>Ingredient</dt>
        <dd>@Model.Ingredient.IngredientName</dd>

        <dt>Quantity</dt>
        <dd>@(Model.Quantity.HasValue ? Model.Quantity.Value.ToString("0.##") : "Not specified")</dd>

        <dt>Unit</dt>
        <dd>@(Model.Unit?.UnitName ?? "Not specified")</dd>
    </dl>

    <form asp-controller="ShoppingList" asp-action="Delete" asp-route-id="@Model.ShoppingListItemId" method="post">
        <button type="submit" class="btn btn--danger-solid">Remove item</button>
    </form>

    <a asp-controller="ShoppingList" asp-action="Index" class="back-link">Cancel</a>
</div>
