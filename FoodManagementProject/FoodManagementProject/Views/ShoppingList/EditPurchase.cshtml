@model FoodManagementProject.Models.ShoppingListPurchaseViewModel

@{
    ViewData["Title"] = "Edit purchased items";
}

<div class="page">
    <h1 class="page__title">Edit purchased items</h1>

    <p class="page__lead">Confirm the quantities you bought. Enter both quantity and unit, or leave both empty. Expiration dates are optional.</p>

    <form asp-controller="ShoppingList" asp-action="SavePurchase" method="post">
        <div asp-validation-summary="All" class="form-errors"></div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Ingredients</th>
                        <th scope="col">Quantity bought</th>
                        <th scope="col">Unit</th>
                        <th scope="col">Expiration date</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i=0; i< Model.Items.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model.Items[i].IngredientName
                                    <input type="hidden" asp-for="Items[i].ShoppingListItemId" />
                                </td>
                                <td>
                                    <input asp-for="Items[i].Quantity" type="number" min="0.01" step="any" aria-label="Quantity bought for @Model.Items[i].IngredientName" class="input" />

                                    <span asp-validation-for="Items[i].Quantity" class="field__error"></span>
                                </td>
                                <td>
                                    <select asp-for="Items[i].UnitId" aria-label="Unit for @Model.Items[i].IngredientName" class="input">
                                        <option value="">Not specified</option>
                                        @foreach (var unit in Model.AvailableUnits) {
                                            <option value="@unit.UnitId">@unit.UnitName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Items[i].UnitId" class="field__error"></span>
                                </td>
                                <td>
                                    <input asp-for="Items[i].ExpirationDate" type="date" aria-label="Expiration date for @Model.Items[i].IngredientName" class="input" />

                                    <span asp-validation-for="Items[i].ExpirationDate" class="field__error"></span>
                                </td>
                            </tr>
                        }
                    </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn--primary">Add to inventory</button>
    </form>

    <a asp-controller="ShoppingList" asp-action="Index" class="back-link">Back to shopping list</a>

</div>
