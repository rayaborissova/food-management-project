@model FoodManagementProject.Models.ShoppingListReviewViewModel

@{
    ViewData["Title"] = "Review shopping list ingredients";
}

<div class="page">
    <h1 class="page__title">Review ingredients</h1>
    <p class="page__lead">Quantity and unit are optional. If you enter one, please provide both.</p>

    <form asp-controller="ShoppingList" asp-action="Save" method="post">
        <div asp-validation-summary="All" class="inventory-validation-errors"></div>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Ingredient</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Unit</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i=0;i<Model.Items.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model.Items[i].IngredientName
                                    <input type="hidden" asp-for="Items[i].IngredientId" />
                                </td>
                                <td>
                                    <input asp-for="Items[i].Quantity" type="number" min="0.01" step="any" aria-label="Quantity for @Model.Items[i].IngredientName" class="input" />
                                    <span asp-validation-for="Items[i].Quantity" class="inventory-validation-errors"></span>
                                </td>
                                <td>
                                    <select asp-for="Items[i].UnitId" aria-label="Unit for @Model.Items[i].IngredientName" class="input">
                                    <option value="">Not specified</option>
                                        @foreach (var unit in Model.AvailableUnits)
                                            {
                                                <option value="@unit.UnitId">@unit.UnitName</option>
                                            }
                                        </select> 
                                        <span asp-validation-for="Items[i].UnitId" class="inventory-validation-errors"></span>
                                </td>
                            </tr>
                        }
                </tbody>
            </table>
        </div>

        <button type="submit" class="btn btn--primary">Add to shopping list</button>

    </form>

    <a asp-controller="ShoppingList" asp-action="Add" class="back-link">Back to selection</a>
</div>