@model FoodManagementProject.Models.Ingredient

@{
    ViewData["Title"] = "Create ingredient";
}

<div class="page page--narrow">
    <h1 class="page__title">Create ingredient</h1>
    <p class="page__lead">Add a new ingredient to the catalogue.</p>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <div class="field">
            <label asp-for="CategoryId" class="field__label"></label>
            <input asp-for="CategoryId" class="input" />
            <span asp-validation-for="CategoryId" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="IngredientName" class="field__label"></label>
            <input asp-for="IngredientName" class="input" />
            <span asp-validation-for="IngredientName" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="IngredientSource" class="field__label"></label>
            <input asp-for="IngredientSource" class="input" />
            <span asp-validation-for="IngredientSource" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Status" class="field__label"></label>
            <input asp-for="Status" class="input" />
            <span asp-validation-for="Status" class="field__error"></span>
        </div>

        <button type="submit" class="btn btn--primary">Create</button>
    </form>

    <a asp-action="Index" class="back-link">Back to List</a>
</div>
