@model FoodManagementProject.Models.Ingredient

@{
    ViewData["Title"] = "Ingredient details";
}

<div class="page page--narrow">
    <h1 class="page__title">@Model.IngredientName</h1>
    <p class="page__lead">Ingredient details</p>

    <div class="card details-card">
        <dl class="details-list">
            <dt>Category</dt>
            <dd>@Model.Category.CategoryName</dd>

            <dt>@Html.DisplayNameFor(model => model.IngredientNameNormalized)</dt>
            <dd>@Html.DisplayFor(model => model.IngredientNameNormalized)</dd>

            <dt>@Html.DisplayNameFor(model => model.IngredientSource)</dt>
            <dd>@Html.DisplayFor(model => model.IngredientSource)</dd>

            <dt>@Html.DisplayNameFor(model => model.Status)</dt>
            <dd>@Html.DisplayFor(model => model.Status)</dd>
        </dl>
    </div>
    <div class="toolbar">
        <a asp-action="Edit" asp-route-id="@Model.IngredientId" class="btn btn--outline">Edit</a>
        <a asp-action="Index" class="back-link">Back to List</a>
    </div>
</div>
