@model FoodManagementProject.Models.ProfilePageViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="page">
    <h1 class="page__title">Profile</h1>

    @if (TempData["ProfileMessage"] is string message)
    {
        <p role="status">@message</p>
    }

    <h2>Account</h2>
    <dl class="details-list">

        @if (Model.Role != AppRoles.Regular)
        {
            <dt>Role</dt>
            <dd>@Model.Role</dd>
        }

        <dt>Registered</dt>
        <dd>@Model.Registered.ToString("dd/MM/yyyy")</dd>

        @if (Model.HouseholdName != null)
        {
            <dt>Household</dt>
            <dd>@Model.HouseholdName (@Model.HouseholdRole)</dd>
        }
    </dl>

    @if (User.IsInRole(AppRoles.Regular))
    {
        <h2>My activity</h2>
        <ul>
            <li><a asp-controller="IngredientRequests" asp-action="Index">My ingredient suggestions</a></li>
            <li><a asp-controller="IngredientReports" asp-action="Index">My reports</a></li>
        </ul>
    }

    <h2>Your details</h2>
    <form asp-controller="Profile" asp-action="UpdateDetails" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <div class="field">
            <label asp-for="Details.DisplayName" class="field__label"></label>
            <input asp-for="Details.DisplayName" class="input" maxlength="100" autocomplete="name" />
            <span asp-validation-for="Details.DisplayName" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Details.Email" class="field__label"></label>
            <input asp-for="Details.Email" class="input" maxlength="255" autocomplete="username" />
            <span asp-validation-for="Details.Email" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Details.CurrentPassword" class="field__label"></label>
            <input asp-for="Details.CurrentPassword" class="input" autocomplete="current-password" value="@Model.Details.CurrentPassword" />
            <span asp-validation-for="Details.CurrentPassword" class="field__error"></span>
        </div>

        <button type="submit" class="btn btn--primary">Save details</button>
    </form>

    <h2>Change password</h2>
    <form asp-controller="Profile" asp-action="ChangePassword" method="post">
        <div class="field">
            <label asp-for="Password.CurrentPassword" class="field__label"></label>
            <input asp-for="Password.CurrentPassword" class="input" autocomplete="current-password" value="@Model.Password.CurrentPassword" />
            <span asp-validation-for="Password.CurrentPassword" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Password.NewPassword" class="field__label"></label>
            <input asp-for="Password.NewPassword" class="input" autocomplete="new-password" value="@Model.Password.NewPassword" />
            <span asp-validation-for="Password.NewPassword" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Password.ConfirmPassword" class="field__label"></label>
            <input asp-for="Password.ConfirmPassword" class="input" autocomplete="new-password" value="@Model.Password.NewPassword" />
            <span asp-validation-for="Password.ConfirmPassword" class="field__error"></span>
        </div>

        <button type="submit" class="btn btn--primary">Change password</button>
    </form>

    <h2>Log out</h2>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn--danger">Log out</button>
    </form>

</div>
