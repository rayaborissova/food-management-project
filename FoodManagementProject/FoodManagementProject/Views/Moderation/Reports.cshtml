@model List<FoodManagementProject.Models.IngredientReport>

@{
    ViewData["Title"] = "Reports";
}

<div class="page page--wide">
    <h1 class="page__title">Ingredient reports</h1>

    @if (TempData["ModerationMessage"] is string message)
    {
        <p class="notice" role="status">@message</p>
    }
    @if (TempData["ModerationError"] is string error)
    {
        <p class="notice notice--error" role="alert">@error</p>
    }

    @if (!Model.Any())
    {
        <p class="empty-state">No reports are waiting for review.</p>
    } else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Ingredient</th>
                        <th scope="col">Category</th>
                        <th scope="col">Reason</th>
                        <th scope="col">Reported by</th>
                        <th scope="col">Waiting</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        <tr>
                            <td>@report.Ingredient.IngredientName</td>
                            <td>@report.Ingredient.Category?.CategoryName</td>
                            <td>@ReportReasons.Label(report.Reason)</td>
                            <td>@report.Reporter.DisplayName</td>
                            <td>@((int)(DateTime.UtcNow - report.DateCreated).TotalDays) days</td>
                            <td><a asp-controller="Moderation" asp-action="ReviewReport" asp-route-id="@report.ReportId" class="btn btn--primary btn--sm">Review</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    
    <a asp-controller="Moderation" asp-action="Index" class="back-link">Back to suggestions</a>
</div>
