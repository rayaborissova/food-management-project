@model FoodManagementProject.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Choose a new password";
}

<div class="page page--narrow auth">
    <h1 class="page__title">Choose a new password</h1>

    @if (!Model.TokenIsValid)
    {
        <p class="form-errors" role="alert">This link is invalid, expired or already used.</p>
        <p class="auth-switch auth-switch--inline"><a asp-controller="Account" asp-action="ForgotPassword">Request a new link</a></p>
    } else
    {
        <form asp-controller="Account" asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>
            <input type="hidden" asp-for="Token" />

            <div class="field">
                <label asp-for="Password" class="field__label"></label>
                <input asp-for="Password" class="input" autocomplete="new-password" value="@Model.Password" />
                <span asp-validation-for="Password" class="field__error"></span>
                <ul class="password-rules" data-for="Password">
                    <li data-rule="length"><i class="ti ti-circle-x" aria-hidden="true"></i>At least 8 characters</li>
                    <li data-rule="letter"><i class="ti ti-circle-x" aria-hidden="true"></i>1 letter</li>
                    <li data-rule="number"><i class="ti ti-circle-x" aria-hidden="true"></i>1 number</li>
                    <li data-rule="special"><i class="ti ti-circle-x" aria-hidden="true"></i>1 special character</li>
                </ul>
            </div>


            <div class="field">
                <label asp-for="ConfirmPassword" class="field__label"></label>
                <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" value="@Model.ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword" class="field__error"></span>
            </div>

            <button type="submit" class="btn btn--primary btn--block">Change Password</button>
        </form>
    }
</div>
