@model FoodManagementProject.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Choose a new password";
}

<div class="page page--narrow">
    <h1 class="page__title">Choose a new password</h1>

    @if (!Model.TokenIsValid)
    {
        <p class="form-errors" role="alert">This link is invalid, expired or already used.</p>
        <p class="auth-switch"><a asp-controller="Account" asp-action="ForgotPassword">Request a new link</a></p>
    } else
    {
        <form asp-controller="Account" asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="form-errors"></div>
            <input type="hidden" asp-for="Token" />

            <div class="field">
                <label asp-for="Password" class="field__label"></label>
                <input asp-for="Password" class="input" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field__error"></span>
            </div>


            <div class="field">
                <label asp-for="ConfirmPassword" class="field__label"></label>
                <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field__error"></span>
            </div>

            <button type="submit" class="btn btn--primary">Change Password</button>
        </form>
    }
</div>
