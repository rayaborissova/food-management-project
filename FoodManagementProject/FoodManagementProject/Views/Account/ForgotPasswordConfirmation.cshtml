@{
    ViewData["Title"] = "Check your email";
}

<div class="page page--narrow">
    <h1 class="page__title">Check your email</h1>
    <p class="page__lead">If an account exists for that address, a link to reset the password will be sent. It works for 1 hour.</p>

    <p class="auth-switch"><a asp-controller="Account" asp-action="Login">Back to login</a></p>
</div>
