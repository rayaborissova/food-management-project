@model FoodManagementProject.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="page page--narrow auth">
    <h1 class="page__title">Create an account</h1>

    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <div class="field">
            <label asp-for="DisplayName" class="field__label"></label>
            <input asp-for="DisplayName" class="input" autocomplete="name" />
            <span asp-validation-for="DisplayName" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Email" class="field__label"></label>
            <input asp-for="Email" class="input" autocomplete="username" />
            <span asp-validation-for="Email" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Password" class="field__label"></label>
            <input asp-for="Password" class="input" autocomplete="new-password" value="@Model.Password" />
            <span asp-validation-for="Password" class="field__error"></span>
            <ul class="password-rules" data-for="Password">
                <li data-rule="length"><i class="ti ti-circle-x" aria-hidden="true"></i>At least 8 characters</li>
                <li data-rule="letter"><i class="ti ti-circle-x" aria-hidden="true"></i>1 letter</li>
                <li data-rule="number"><i class="ti ti-circle-x" aria-hidden="true"></i>1 number</li>
                <li data-rule="special"><i class="ti ti-circle-x" aria-hidden="true"></i>1 special character</li>
            </ul>
        </div>

        <button type="submit" class="btn btn--primary btn--block">Register</button>
    </form>

    <p class="auth-switch">Already registered? <a asp-controller="Account" asp-action="Login">Log in</a></p>
</div>