@model FoodManagementProject.Models.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<div class="page page--narrow">
    <h1 class="page__title">Log in</h1>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <div class="field">
            <label asp-for="Email" class="field__label"></label>
            <input asp-for="Email" class="input" autocomplete="username"/>
            <span asp-validation-for="Email" class="field__error"></span>
        </div>

        <div class="field">
            <label asp-for="Password" class="field__label"></label>
            <input asp-for="Password" class="input" autocomplete="current-password"/>
            <span asp-validation-for="Password" class="field__error"></span>
        </div>

        <div class="field">
            <label>
                <input asp-for="RememberMe"/> @Html.DisplayNameFor(m => m.RememberMe)
            </label>
        </div>

        <button type="submit" class="btn btn--primary">Log in</button>
    </form>

    <p class="auth-switch">No account yet? <a asp-controller="Account" asp-action="Register">Register</a></p>
</div>