@model FoodManagementProject.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "ForgotPassword";
}

<div class="page page--narrow">
    <h1 class="page__title">Forgot your password?</h1>
    <p class="page__lead">Enter the email of your account. If it exists, we'll send a link to choose a new password.</p>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <div class="field">
            <label asp-for="Email" class="field__label"></label>
            <input asp-for="Email" class="input" autocomplete="username" />
            <span asp-validation-for="Email" class="field__error"></span>
        </div>

        <button type="submit" class="btn btn--primary">Send reset link</button>
    </form>

    <p class="auth-switch"><a asp-controller="Account" asp-action="Login">Back to login</a></p>

</div>
