@model FoodManagementProject.Models.HouseholdIndexViewModel

@{
    ViewData["Title"] = "Household";
}

<div class="page">
    <h1 class="page__title">Household</h1>

    <!--messages and errors-->
    @if (TempData["HouseholdMessage"] is string message)
    {
        <p role="status">@message</p>
    }

    @if (TempData["HouseholdError"] is string error)
    {
        <p class="form-errors" role="alert">@error</p>
    }

    <!--if not in a shared household-->
    @if(!Model.IsShared) 
    {
        <p class="page__lead">You are using your personal fridge. Create a shared household, or join one with an invite code.</p>
        
        <!--join form-->
        <h2>Join with an invite code</h2>
        <form asp-controller="Household" asp-action="Join" method="post">
            <div class="field">
                <label asp-for="Join.Code" class="field__label"></label>
                <input asp-for="Join.Code" class="input" autocomplete="off" maxlength="12" />
            </div>
            <button type="submit" class="btn btn--primary">Join household</button>
        </form>


        <!--create household-->
        <h2>Create a shared household</h2>
        <form asp-controller="Household" asp-action="Create" method="post">
            <div class="field">
                <label asp-for="Create.Name" class="field__label"></label>
                <input asp-for="Create.Name" class="input" maxlength="100" />
            </div>
            <fieldset class="field-group">
                <legend class="field__label">Ingredients</legend>
                <label class="radio-option">
                    <input type="radio" name="Create.CopyInventory" value="false" class="checkbox" checked />
                    Start with an empty household
                </label>
                <label class="radio-option">
                    <input type="radio" name="Create.CopyInventory" value="true" class="checkbox" disabled="@(Model.PersonalInventoryCount == 0)" />
                    Copy my current ingredients (@Model.PersonalInventoryCount @(Model.PersonalInventoryCount ==  1 ? "batch" : "batches"))
                </label>

                <p class="page__lead">Your personal inventory stays unchanged, The copy is a separate list that belongs to the new household.</p>
            </fieldset>

            <button type="submit" class="btn btn--primary">Create Household</button>
        </form>
    } else
    {
        <!--existing household details-->
        <p class="page__lead">Shared household: <strong>@Model.HouseholdName</strong></p>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Member</th>
                        <th scope="col">Role</th>
                        <th scope="col">Joined</th>
                        @if (Model.IsOwner)
                        {
                            <th scope="col">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td>@member.User.DisplayName</td>
                            <td>@member.HouseholdRole</td>
                            <td>@member.DateJoined.ToString("dd/MM/yyyy")</td>
                            @if (Model.IsOwner)
                            {
                                <td>
                                    @if (member.UserId == Model.CurrentUserId)
                                    {
                                        <span>(you)</span> <!--owner cannot remove themselves the same way they would a member-->
                                    } else
                                    {
                                        <form asp-controller="Household" asp-action="RemoveMember" method="post" class="inline-form" data-confirm="Remove @member.User.DisplayName from this household?.">
                                            <input type="hidden" name="memberUserId" value="@member.UserId" />
                                            <button type="submit" class="btn btn--danger btn--sm">Remove</button> 
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!--button to leave household-->
        <h2>Leave household</h2>
        <p class="page__lead">You will return to your personal inventory and shopping list.</p>
        <form id="leave-form" asp-controller="Household" asp-action="Leave" method="post" data-last-member="@(Model.Members.Count == 1 ? "true" : "false")"> 
            <input type="hidden" id="confirm-delete" name="confirmDelete" value="false" />
            <button type="submit" class="btn btn--danger">Leave household</button>
        </form>

        <!--invite creation-->
        <h2>Invite people</h2>
        <!--if a code has already been generated, display it-->
        @if (Model.ActiveCode != null) 
        {
            <p class="invite-code">@Model.ActiveCode</p>
            <p class="page__lead">Valid until @Model.CodeExpiresAt?.ToString("dd/MM/yyyy HH:mm") (UTC). Anyone with the code can join.</p>
        }
        <!--if not generated, form to generate it-->
        <form asp-controller="Household" asp-action="GenerateInvite" method="post">
            <button type="submit" class="btn btn--primary">
                @(Model.ActiveCode == null ? "Generate invite code" : "Generate a new code")
            </button>
        </form>
    }

</div>

<script>

    // confirmation for members leaving on their own
    const leaveForm = document.getElementById("leave-form");

    if (leaveForm) {
        const confirmDelete = document.getElementById("confirm-delete");

        leaveForm.addEventListener("submit", function (event) {
            
            // first confirmation, always shown
            if (!confirm("Leave this household?")) {
                event.preventDefault();
                return;
            }

            // second confirmation, only shown to the last member of the household
            if (leaveForm.dataset.lastMember === "true") {
                const confirmed = confirm("You are the last member. Leaving will permanently delete this household, its inventory and its shopping list. Continue?");
            
                if (!confirmed) {
                    event.preventDefault();
                    return;
                }

                //deletion warning was accepted
                confirmDelete.value = "true";
            }
        });
    }

    // confirmation of the member removal by the owner
    for (const form of document.querySelectorAll("form[data-confirm]")) {
        form.addEventListener("submit", function(event) {
            if (!confirm(form.dataset.confirm)) {
                event.preventDefault();
            }
        });
    }
</script>