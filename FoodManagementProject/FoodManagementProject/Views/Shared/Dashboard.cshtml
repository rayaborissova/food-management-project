@model FoodManagementProject.Models.DashboardViewModel

@{
    ViewData["Title"] = Model.Heading;
}

<div class="page page--wide">
    <h1 class="page__title">@Model.Heading</h1>
    @if (!string.IsNullOrEmpty(Model.Lead))
    {
        <p class="page__lead">@Model.Lead</p>
    }

    <div class="summary-grid">
        @foreach (var card in Model.Cards)
        {
            <partial name="_SummaryCard" model="card" />
        }
    </div>
</div>