@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page page--narrow">
    <h1 class="page__title">Something went wrong</h1>
    <p class="page__lead">An error occurred while processing your request. Please try again in a moment.</p>

    @if (Model.ShowRequestId)
    {
        <p class="page__lead">Request ID: <code>@Model.RequestId</code></p>
    }
    
    <a asp-controller="Home" asp-action="Index" class="back-link">Back to my start page</a>
</div>