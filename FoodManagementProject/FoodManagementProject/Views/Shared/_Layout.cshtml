<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodManagementProject</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodManagementProject.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.52.0/dist/tabler-icons.min.css" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <div class="app">
        @if (User.Identity?.IsAuthenticated == true) //display it only if the user logged in
        {
            <nav class="sidebar" aria-label="Main">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">Home</a>

                @if (User.IsInRole(AppRoles.Regular))
                {
                    <button type="button" class="btn btn--primary add-trigger" aria-haspopup="menu" aria-expanded="false" aria-controls="add-menu">
                        <i class="ti ti-plus" aria-hidden="true"></i>Add
                    </button>
                    <a class="nav-link @(controller == "Inventory" ? "is-active" : "")" asp-controller="Inventory" asp-action="Index"><i class="ti ti-fridge" aria-hidden="true"></i>Fridge</a>
                    <a class="nav-link @(controller == "ShoppingList" ? "is-active" : "")" asp-controller="ShoppingList" asp-action="Index"><i class="ti ti-shopping-cart" aria-hidden="true"></i>Shopping List</a>
                    <a class="nav-link @(controller == "Household" ? "is-active" : "")" asp-controller="Household" asp-action="Index"><i class="ti ti-home" aria-hidden="true"></i>Household</a>
                    <a class="nav-link @(controller == "Recipes" ? "is-active" : "")" asp-controller="Recipes" asp-action="Index"><i class="ti ti-chef-hat" aria-hidden="true"></i>Recipes</a>
                }
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a class="nav-link @(controller == "Admin" && action == "Dashboard" ? "is-active" : "")" asp-controller="Admin" asp-action="Dashboard"><i class="ti ti-layout-dashboard" aria-hidden="true"></i>Dashboard</a>
                    <a class="nav-link @(controller == "Admin" && action != "Dashboard" ? "is-active" : "")" asp-controller="Admin" asp-action="Index"><i class="ti ti-users" aria-hidden="true"></i>Users</a>
                    <a class="nav-link @(controller == "Ingredients" ? "is-active" : "")" asp-controller="Ingredients" asp-action="Index"><i class="ti ti-carrot" aria-hidden="true"></i>Ingredients</a>
                    <a class="nav-link @(controller == "ReportedIngredients" ? "is-active" : "")" asp-controller="ReportedIngredients" asp-action="Index"><i class="ti ti-flag" aria-hidden="true"></i>Reports @await Component.InvokeAsync("StaffBadge", new { kind = "reports" })</a>
                }
                @if (User.IsInRole(AppRoles.Moderator))
                {
                    <a class="nav-link @(controller == "Moderation" && action == "Dashboard" ? "is-active" : "")" asp-controller="Moderation" asp-action="Dashboard"><i class="ti ti-layout-dashboard" aria-hidden="true"></i>Dashboard</a>
                    <a class="nav-link @(controller == "Moderation" && (action == "Index" || action == "Review" || action == "History") ? "is-active" : "")" asp-controller="Moderation" asp-action="Index"><i class="ti ti-shield-check" aria-hidden="true"></i>Suggestions @await Component.InvokeAsync("StaffBadge", new { kind = "suggestions" })</a>
                    <a class="nav-link @(controller == "Moderation" && (action == "Reports" || action == "ReviewReport" || action == "ReportHistory") ? "is-active" : "")" asp-controller="Moderation" asp-action="Reports"><i class="ti ti-flag" aria-hidden="true"></i>Reports @await Component.InvokeAsync("StaffBadge", new { kind = "open-reports" })</a>
                }

                <form asp-controller="Account" asp-action="Logout" method="post" class="sidebar__logout">
                    <a asp-controller="Profile" asp-action="Index" class="sidebar__user"><i class="ti ti-user" aria-hidden="true"></i>@User.Identity.Name</a>
                    <button type="submit" class="nav-link nav-link--button"><i class="ti ti-logout" aria-hidden="true"></i>Log out</button>
                </form>
            </nav>
        }
        <main role="main" class="app__main">
            <header class="topbar@(User.Identity?.IsAuthenticated == true ? "" : " topbar--guest")">
                <a class="topbar__brand" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
            </header>
            <div class="app__body">
                @RenderBody()
            </div>
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated == true) //display it only if the user logged in
    {
        <nav class="tabbar" aria-label="Main (mobile)">
            @if (User.IsInRole(AppRoles.Regular))
            {
                <a class="nav-link @(controller == "Inventory" ? "is-active" : "")" asp-controller="Inventory" asp-action="Index"><i class="ti ti-fridge" aria-hidden="true"></i>Fridge</a>
                <a class="nav-link @(controller == "ShoppingList" ? "is-active" : "")" asp-controller="ShoppingList" asp-action="Index"><i class="ti ti-shopping-cart" aria-hidden="true"></i>Shopping List</a>
                <button type="button" class="tabbar__fab add-trigger" aria-label="Add" aria-haspopup="menu" aria-expanded="false" aria-controls="add-menu"><i class="ti ti-plus" aria-hidden="true"></i></button>
                <a class="nav-link @(controller == "Household" ? "is-active" : "")" asp-controller="Household" asp-action="Index"><i class="ti ti-home" aria-hidden="true"></i>Household</a>
            }
            @if (User.IsInRole(AppRoles.Admin))
            {
                <a class="nav-link @(controller == "Admin" && action == "Dashboard" ? "is-active" : "")" asp-controller="Admin" asp-action="Dashboard"><i class="ti ti-layout-dashboard" aria-hidden="true"></i>Dashboard</a>
                <a class="nav-link @(controller == "Admin" && action != "Dashboard" ? "is-active" : "")" asp-controller="Admin" asp-action="Index"><i class="ti ti-users" aria-hidden="true"></i>Users</a>
                <a class="nav-link @(controller == "Ingredients" ? "is-active" : "")" asp-controller="Ingredients" asp-action="Index"><i class="ti ti-carrot" aria-hidden="true"></i>Ingredients</a>
                <a class="nav-link @(controller == "ReportedIngredients" ? "is-active" : "")" asp-controller="ReportedIngredients" asp-action="Index"><i class="ti ti-flag" aria-hidden="true"></i>Reports @await Component.InvokeAsync("StaffBadge", new { kind = "reports" })</a>
            }
            @if (User.IsInRole(AppRoles.Moderator))
            {
                <a class="nav-link @(controller == "Moderation" && action == "Dashboard" ? "is-active" : "")" asp-controller="Moderation" asp-action="Dashboard"><i class="ti ti-layout-dashboard" aria-hidden="true"></i>Dashboard</a>
                <a class="nav-link @(controller == "Moderation" && (action == "Index" || action == "Review" || action == "History") ? "is-active" : "")" asp-controller="Moderation" asp-action="Index"><i class="ti ti-shield-check" aria-hidden="true"></i>Suggestions @await Component.InvokeAsync("StaffBadge", new { kind = "suggestions" })</a>
                <a class="nav-link @(controller == "Moderation" && (action == "Reports" || action == "ReviewReport" || action == "ReportHistory") ? "is-active" : "")" asp-controller="Moderation" asp-action="Reports"><i class="ti ti-flag" aria-hidden="true"></i>Reports @await Component.InvokeAsync("StaffBadge", new { kind = "open-reports" })</a>
            }

            <a class="nav-link @(controller == "Profile" ? "is-active" : "")" asp-controller="Profile" asp-action="Index"><i class="ti ti-user" aria-hidden="true"></i>Profile</a>
        </nav>

        @if (User.IsInRole(AppRoles.Regular))
        {
            <div class="add-overlay" id="add-overlay" hidden></div>
            <div class="add-menu" id="add-menu" role="menu" hidden>
                <a class="add-menu__item" role="menuitem" asp-controller="Inventory" asp-action="Add"><i class="ti ti-fridge" aria-hidden="true"></i>Add to fridge</a>
                <a class="add-menu__item" role="menuitem" asp-controller="ShoppingList" asp-action="Add"><i class="ti ti-shopping-cart-plus" aria-hidden="true"></i>Add to shopping list</a>
                <a class="add-menu__item" role="menuitem" asp-controller="IngredientRequests" asp-action="Index"><i class="ti ti-bulb" aria-hidden="true"></i>Suggest an ingredient</a>
            </div>
        }
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
